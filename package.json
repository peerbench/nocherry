{
  "name": "nocherry-commit-reveal",
  "private": true,
  "workspaces": [
    "packages/*",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build packages/pb-wasm --target nodejs --out-dir ../../pkg --scope nocherry",
    "build:wasm:server": "wasm-pack build packages/pb-wasm --target nodejs --out-dir ../../pkg-server --scope nocherry -- --no-default-features",
    "build": "npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2"
  }
}
